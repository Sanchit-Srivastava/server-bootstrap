#!/usr/bin/env bash
set -euo pipefail

SESSIONIZER_DIRS="${SESSIONIZER_DIRS:-$HOME/Projects:$HOME/services}"

list_candidate_dirs() {
	local scan_root
	local -a scan_roots

	{
		if command -v zoxide >/dev/null 2>&1; then
			zoxide query --list
		fi

		IFS=: read -r -a scan_roots <<<"$SESSIONIZER_DIRS"
		for scan_root in "${scan_roots[@]}"; do
			[[ -d "$scan_root" ]] || continue
			find "$scan_root" -name .git -prune -exec dirname {} \; 2>/dev/null
		done
	} | awk 'NF && !seen[$0]++'
}

if [[ "${1:-}" == "--list" ]]; then
	list_candidate_dirs
	exit 0
fi

if [[ -n "${1:-}" ]]; then
	selected="$1"
else
	selected="$(list_candidate_dirs | fzf --prompt='session: ' --height=40% --layout=reverse --border)" || exit 0
fi

[[ -n "${selected:-}" ]] || exit 0
[[ -d "$selected" ]] || {
	printf '%s\n' "tmux-sessionizer: not a directory: $selected" >&2
	exit 1
}

# Canonical paths give symlink/relative aliases one identity, and distinguish
# projects with the same basename. Never reuse a session for a different path.
selected="$(cd -- "$selected" && pwd -P)"
path_hash="$(printf '%s' "$selected" | sha256sum)"
readable_name="$(printf '%s' "${selected##*/}" | LC_ALL=C tr -c 'a-zA-Z0-9_-' '_')"
session_name="${readable_name:0:40}-${path_hash:0:16}"
if ! tmux has-session -t "=$session_name" 2>/dev/null; then
	tmux new-session -ds "$session_name" -c "$selected"
	tmux set-option -t "=$session_name:" @sessionizer-path "$selected"
elif [[ "$(tmux show-options -t "=$session_name:" -qv @sessionizer-path)" != "$selected" ]]; then
	printf '%s\n' "tmux-sessionizer: session path conflict: $session_name" >&2
	exit 1
fi

if [[ -n "${TMUX:-}" ]]; then
	tmux switch-client -t "=$session_name"
else
	tmux attach-session -t "=$session_name"
fi
